DATABASE_URL=postgresql://user:password@localhost:5432/alertiq
DEDUP_WINDOW_SECONDS=300
JWT_SECRET=your-secret-key-here
JWT_EXPIRE_MINUTES=480
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
CORS_ORIGINS=http://localhost:3000

# Leave empty for local testing; set a long random value before exposing the API
INGEST_API_KEY=
# true = anyone can sign up as analyst; false = only the first user (admin) self-registers
ALLOW_REGISTRATION=false

# AI triage: auto | anthropic | claude_cli | ollama | rules
#   auto = anthropic if ANTHROPIC_API_KEY set, else claude_cli if `claude` installed, else rules (all free except anthropic)
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Used only when AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=4096
